<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\TelDiskCleaner.Core\TelDiskCleaner.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\teldiskcleaner.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    <ApplicationIcon>Assets\teldiskcleaner.ico</ApplicationIcon>
    <AssemblyTitle>TelDiskCleaner</AssemblyTitle>
    <Product>TelDiskCleaner</Product>
    <Version>1.1.0</Version>
  </PropertyGroup>

</Project>
