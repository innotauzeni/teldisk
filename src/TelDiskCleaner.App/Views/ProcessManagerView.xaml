<UserControl x:Class="TelDiskCleaner.App.Views.ProcessManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TelDiskCleaner.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:ProcessManagerViewModel}"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="{Binding MemorySummary}" FontWeight="SemiBold" FontSize="14" />
            <ProgressBar Value="{Binding MemoryPercent, Mode=OneWay}" Maximum="100" Height="10" Width="420"
                         HorizontalAlignment="Left" Margin="0,4,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Width="180" VerticalContentAlignment="Center" />
            <CheckBox Content="Auto refresh" IsChecked="{Binding AutoRefresh}" VerticalAlignment="Center" Margin="16,0,0,0" />
            <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="12,0,0,0" Padding="8,3" />
            <Button Content="Shut down WSL / Docker VM" Command="{Binding ShutdownWslCommand}" Margin="12,0,0,0" Padding="8,3"
                    Visibility="{Binding ShowWslShutdown, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <TextBlock Text="{Binding StatusMessage}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Foreground="#555555" TextWrapping="Wrap"
                       Text="End task closes an app immediately, so unsaved work in it is lost. Windows processes are protected and can't be ended here." />
        </StackPanel>

        <DataGrid Grid.Row="3" ItemsSource="{Binding ProcessesView}" AutoGenerateColumns="False"
                  CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  EnableRowVirtualization="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="App" Binding="{Binding DisplayName}" SortMemberPath="Name" Width="190" />
                <DataGridTextColumn Header="Memory" Binding="{Binding MemoryDisplay}" SortMemberPath="MemoryBytes" Width="95" />
                <DataGridTextColumn Header="CPU" Binding="{Binding CpuDisplay}" SortMemberPath="CpuPercent" Width="65" />
                <DataGridTextColumn Header="What it is" Binding="{Binding Note}" Width="260" />
                <DataGridTextColumn Header="Location" Binding="{Binding ExecutablePath}" Width="*" />
                <DataGridTemplateColumn Header="" Width="85">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="End task" Margin="2" Padding="6,2" Click="OnEndTaskClick"
                                    IsEnabled="{Binding CanEnd}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
