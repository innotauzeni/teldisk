<UserControl x:Class="TelDiskCleaner.App.Views.ProjectCleanerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TelDiskCleaner.App.ViewModels"
             xmlns:conv="clr-namespace:TelDiskCleaner.App.Converters"
             d:DataContext="{d:DesignInstance Type=vm:ProjectCleanerViewModel}"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">
    <UserControl.Resources>
        <conv:InverseBooleanConverter x:Key="InverseBoolean" />
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Project roots to scan" FontWeight="Bold" Margin="0,0,0,4" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,4">
            <TextBox Text="{Binding NewRootPath, UpdateSourceTrigger=PropertyChanged}" Width="420" />
            <Button Content="Add" Margin="8,0,0,0" Command="{Binding AddRootCommand}" />
        </StackPanel>

        <ListBox Grid.Row="2" ItemsSource="{Binding ProjectRoots}" MaxHeight="80" Margin="0,0,0,8">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding}" VerticalAlignment="Center" Width="400" />
                        <Button Content="Remove"
                                Command="{Binding DataContext.RemoveRootCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Flag as inactive after (days):" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Text="{Binding ThresholdDays, UpdateSourceTrigger=PropertyChanged}" Width="60" />
            <Button Content="Scan for candidates" Margin="16,0,0,0" Command="{Binding ScanCommand}"
                    IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBoolean}}" />
            <Button Content="Cancel" Margin="8,0,0,0" Command="{Binding CancelCommand}"
                    IsEnabled="{Binding IsScanning}" />
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="16,0,0,0" />
        </StackPanel>

        <DataGrid Grid.Row="4" ItemsSource="{Binding Candidates}" AutoGenerateColumns="False"
                  CanUserAddRows="False" IsReadOnly="False">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected}" />
                <DataGridTextColumn Header="Project" Binding="{Binding ProjectRoot}" Width="260" IsReadOnly="True" />
                <DataGridTextColumn Header="Artifacts" Binding="{Binding ArtifactBreakdown}" Width="260" IsReadOnly="True" />
                <DataGridTextColumn Header="Size" Binding="{Binding TotalSizeDisplay}" Width="90" IsReadOnly="True" />
                <DataGridTextColumn Header="Last activity" Binding="{Binding LastActivityDisplay}" Width="180" IsReadOnly="True" />
                <DataGridTemplateColumn Header="Pin">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Pin"
                                    Command="{Binding DataContext.PinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" IsEnabled="{Binding IsPinned, Converter={StaticResource InverseBoolean}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Delete selected" Click="OnDeleteSelectedClick" Padding="8,4" />
            <TextBlock Text="{Binding SelectedTotalDisplay, StringFormat='Total selected: {0}'}" VerticalAlignment="Center" Margin="16,0,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
