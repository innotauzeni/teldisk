<Window x:Class="TelDiskCleaner.App.Views.ConfirmDeleteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm delete" Height="420" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="HeaderText" TextWrapping="Wrap" Margin="0,0,0,8" FontWeight="Bold" />

        <ListBox Grid.Row="1" x:Name="PathsList" />

        <TextBlock Grid.Row="2" Text="This cannot be undone." Foreground="DarkRed" Margin="0,8,0,8" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="80" Margin="0,0,8,0" IsCancel="True" Click="OnCancelClick" />
            <Button Content="Delete" Width="80" Click="OnDeleteClick" />
        </StackPanel>
    </Grid>
</Window>
