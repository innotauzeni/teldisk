<UserControl x:Class="TelDiskCleaner.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TelDiskCleaner.App.ViewModels"
             xmlns:conv="clr-namespace:TelDiskCleaner.App.Converters"
             d:DataContext="{d:DesignInstance Type=vm:HomeViewModel}"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             Background="#F8FAFC">
    <UserControl.Resources>
        <conv:InverseBooleanConverter x:Key="InverseBoolean" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,16,8,16">
            <TextBlock Text="Your PC at a glance" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{Binding StatusMessage}" FontWeight="SemiBold" Margin="0,0,0,10" TextWrapping="Wrap" />

            <Border Background="#FFF7E6" BorderBrush="#F8B51C" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,12,12"
                    Visibility="{Binding ShowUpgradeHint, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Get Pro" Command="{Binding UpgradeCommand}" Style="{StaticResource Primary}" />
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                               Text="Your free trial has ended. Disk Analyzer is still free; cleaning, backups and the other tools need TelDiskCleaner Pro." />
                </DockPanel>
            </Border>

            <WrapPanel>
                <Border Style="{StaticResource Card}" Width="330">
                    <StackPanel>
                        <TextBlock Text="Junk files" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding JunkSummary}" FontSize="16" TextWrapping="Wrap" Margin="0,0,0,10" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Clean now" Click="OnCleanNowClick" Style="{StaticResource Primary}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolean}}" />
                            <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource Plain}" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="Cleans temp files, the Recycle Bin and safe caches. Use Junk Cleanup to choose exactly what goes."
                                   Style="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Width="330">
                    <StackPanel>
                        <TextBlock Text="Memory" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding MemorySummary}" FontSize="16" TextWrapping="Wrap" />
                        <ProgressBar Value="{Binding MemoryPercent, Mode=OneWay}" Maximum="100" Height="10" Margin="0,8,0,8" />
                        <TextBlock Text="{Binding StartupSummary}" Style="{StaticResource Muted}" />
                        <TextBlock Text="See the Processes tab for what's using memory now." Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Width="330">
                    <StackPanel>
                        <TextBlock Text="Automatic cleaning" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding AutoCleanSummary}" TextWrapping="Wrap" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding LastAutoClean}" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,10" />
                        <Button Content="{Binding AutoCleanButtonText}" Command="{Binding ToggleAutoCleanCommand}" Style="{StaticResource Plain}"
                                HorizontalAlignment="Left" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolean}}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Width="330">
                    <StackPanel>
                        <TextBlock Text="Recovery" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding RecoverySummary}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <TextBlock Text="Drives" Style="{StaticResource SectionTitle}" Margin="0,8,0,8" />
            <ItemsControl ItemsSource="{Binding Drives}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Width="330">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" />
                                <ProgressBar Value="{Binding UsedPercent, Mode=OneWay}" Maximum="100" Height="12" Margin="0,8,0,6">
                                    <ProgressBar.Style>
                                        <Style TargetType="ProgressBar">
                                            <Setter Property="Foreground" Value="#2563D2" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLow}" Value="True">
                                                    <Setter Property="Foreground" Value="#C2410C" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ProgressBar.Style>
                                </ProgressBar>
                                <TextBlock Text="{Binding Detail}" />
                                <TextBlock Text="Low on space: try Clean now or File Finder." Foreground="#C2410C" FontWeight="SemiBold" Margin="0,4,0,0"
                                           Visibility="{Binding IsLow, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
